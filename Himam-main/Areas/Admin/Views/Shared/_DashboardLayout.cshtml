@* Dashboard shell: sidebar + topbar. Used only by Dashboard/Index.cshtml. *@
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>@ViewData["Title"] | همم الحياة</title>
<meta name="description" content="@ViewData["Description"]">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Alexandria:wght@@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/dashboard/admin-dashboard.css">
<script>(function(){try{var t=localStorage.getItem("himam-theme");if(t==="dark"){document.documentElement.setAttribute("data-theme","dark");}}catch(e){}})();</script>
</head>
<body>

<div class="sidebar-backdrop" id="sidebarBackdrop"></div>

<div class="dash-shell">

  <aside class="dash-sidebar" id="dashSidebar">
    <div class="dash-brand">
      <img src="~/assets/logo-stacked-trim.png" alt="همم الحياة">
      <div class="dash-brand-text">لوحة التحكم<span>همم الحياة</span></div>
    </div>

    <div class="dash-role-card">
      <div class="dash-role-avatar">RS</div>
      <div>
        <div class="name">ريم الشهراني</div>
        <div class="role">المدير الأعلى · Super Admin</div>
      </div>
    </div>

    <nav class="dash-nav">
      <div class="dash-nav-group">
        <div class="dash-nav-label">عام</div>
        <button class="dash-nav-item active" data-section="overview">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="8" height="8" rx="2"/><rect x="13" y="3" width="8" height="8" rx="2"/><rect x="3" y="13" width="8" height="8" rx="2"/><rect x="13" y="13" width="8" height="8" rx="2"/></svg>
          نظرة عامة
        </button>
      </div>

      <div class="dash-nav-group">
        <div class="dash-nav-label">المحتوى</div>
        <button class="dash-nav-item" data-section="pages">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M9 13h6M9 17h6M9 9h1"/></svg>
          صفحات الموقع
          <span class="count">5</span>
        </button>
      </div>

      <div class="dash-nav-group">
        <div class="dash-nav-label">الإدارة</div>
        <button class="dash-nav-item" data-section="users">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          إدارة المستخدمين
          <span class="count">12</span>
        </button>
        <button class="dash-nav-item" data-section="permissions">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/></svg>
          إدارة الصلاحيات
        </button>
        <button class="dash-nav-item" data-section="admins">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.5-7 8-7s8 3 8 7"/><path d="M12 1v2M12 1l2 1.2M12 1l-2 1.2"/></svg>
          إنشاء وحذف المديرين
        </button>
      </div>

      <div class="dash-nav-group">
        <div class="dash-nav-label">النظام</div>
        <button class="dash-nav-item" data-section="settings">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1 1.55V21a2 2 0 0 1-4 0v-.09A1.7 1.7 0 0 0 9 19.4a1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.7 1.7 0 0 0 .34-1.87 1.7 1.7 0 0 0-1.55-1H3a2 2 0 0 1 0-4h.09A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.7 1.7 0 0 0 1.87.34H9a1.7 1.7 0 0 0 1-1.55V3a2 2 0 0 1 4 0v.09a1.7 1.7 0 0 0 1 1.55 1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.7 1.7 0 0 0-.34 1.87V9a1.7 1.7 0 0 0 1.55 1H21a2 2 0 0 1 0 4h-.09a1.7 1.7 0 0 0-1.55 1z"/></svg>
          الإعدادات العامة
        </button>
        <button class="dash-nav-item" data-section="security">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/><path d="M9.5 12l1.8 1.8L15 10"/></svg>
          السجلات الأمنية
        </button>
        <button class="dash-nav-item" data-section="integrations">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 3H5a2 2 0 0 0-2 2v4M15 3h4a2 2 0 0 1 2 2v4M9 21H5a2 2 0 0 1-2-2v-4M15 21h4a2 2 0 0 0 2-2v-4"/><circle cx="12" cy="12" r="3"/></svg>
          إدارة التكاملات
        </button>
      </div>
    </nav>

    <div class="dash-sidebar-foot">
      <div class="lang-switch" role="group" aria-label="اللغة">
        <button type="button" class="lang-btn active" data-lang="ar">AR</button>
        <button type="button" class="lang-btn" data-lang="en">EN</button>
      </div>
      <a asp-area="Admin" asp-controller="Account" asp-action="Login" class="dash-logout">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
        تسجيل الخروج
      </a>
    </div>
  </aside>

  <div class="dash-main">
    <header class="dash-topbar">
      <div style="display:flex; align-items:center; gap:14px;">
        <button class="mobile-sidebar-toggle" id="mobileSidebarToggle" aria-label="القائمة">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
        <div>
          <h1 id="topbarTitle">نظرة عامة</h1>
          <div class="dash-topbar-sub" id="topbarSub">ملخص أداء الموقع اليوم</div>
        </div>
      </div>
      <div class="dash-topbar-actions">
        <div class="dash-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
          <input type="text" placeholder="بحث سريع...">
        </div>
        <button type="button" class="icon-btn-dash" aria-label="الإشعارات">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
          <span class="dot"></span>
        </button>
        <button type="button" class="theme-toggle" id="themeToggle" aria-label="تبديل الوضع الليلي/النهاري">
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
      </div>
    </header>

    <main class="dash-content">
@RenderBody()

</main>
  </div>
</div>

<script src="~/js/dashboard/admin-dashboard.js"></script>
</body>
</html>