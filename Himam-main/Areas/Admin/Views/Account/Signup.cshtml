@{
    ViewData["Title"] = "إنشاء حساب فريق العمل";
    ViewData["Description"] = "إنشاء حساب جديد لأحد أعضاء فريق العمل في لوحة تحكم همم الحياة، مع تحديد الدور الوظيفي والصلاحيات.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard/admin-signup.css">
}

<section style="padding-top:50px;">
  <div class="container">
    <div class="auth-wrap">
      <div class="auth-card reveal">

        <form id="adminSignupForm" class="auth-form" asp-action="Signup" method="post">
         @Html.AntiForgeryToken()
         <div class="logo"><img src="~/assets/logo-stacked-trim.png" alt="همم الحياة"></div>

          <div class="stepper">
            <div class="stepper-step is-active" data-step-indicator="1">
              <span class="stepper-circle">1</span>
              <span class="stepper-label">البيانات الأساسية</span>
            </div>
            <div class="stepper-line"></div>
            <div class="stepper-step" data-step-indicator="2">
              <span class="stepper-circle">2</span>
              <span class="stepper-label">الدور الوظيفي</span>
            </div>
            <div class="stepper-line"></div>
            <div class="stepper-step" data-step-indicator="3">
              <span class="stepper-circle">3</span>
              <span class="stepper-label">كلمة المرور</span>
            </div>
          </div>

          <div class="form-step is-active" data-step="1">
            <div class="field-row">
              <div class="field">
                <label for="fullname">الاسم الكامل</label>
                <input type="text" id="fullname" name="fullname" placeholder="اسم عضو الفريق" required>
              </div>
              <div class="field">
                <label for="email">البريد الإلكتروني</label>
                <input type="email" id="email" name="email" placeholder="name@@himamalhayah.sa" required>
              </div>
            </div>

            <div class="field">
              <label for="phone">رقم الجوال (اختياري)</label>
              <input type="tel" id="phone" name="phone" placeholder="05xxxxxxxx">
            </div>

            <div class="step-actions">
              <span></span>
              <button type="button" class="btn btn-primary step-next" data-next="2">التالي
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
              </button>
            </div>
          </div>

          <div class="form-step" data-step="2">
            <div class="field">
              <label>الدور الوظيفي</label>
              <div class="sector-pills role-pills">
                <label class="pill-check"><input type="radio" name="role" value="super" checked>المدير الأعلى</label>
                <label class="pill-check"><input type="radio" name="role" value="manager">مدير الموقع</label>
                <label class="pill-check"><input type="radio" name="role" value="editor">محرر المحتوى</label>
                <label class="pill-check"><input type="radio" name="role" value="support">خدمة العملاء</label>
              </div>
            </div>

            <div class="step-actions">
              <button type="button" class="btn btn-outline step-prev" data-prev="1">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                السابق
              </button>
              <button type="button" class="btn btn-primary step-next" data-next="3">التالي
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
              </button>
            </div>
          </div>

          <div class="form-step" data-step="3">
            <div class="field">
              <label for="password">كلمة المرور</label>
              <div class="password-field">
                <input type="password" id="password" name="password" placeholder="8 أحرف على الأقل" minlength="8" required>
                <button type="button" class="toggle-pass" aria-label="إظهار كلمة المرور" data-target="password">
                  <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
                  <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17.94 17.94A10.94 10.94 0 0 1 12 19c-7 0-11-7-11-7a20.6 20.6 0 0 1 5.06-5.94M9.9 4.24A10.4 10.4 0 0 1 12 4c7 0 11 7 11 7a20.6 20.6 0 0 1-3.22 4.19M14.12 14.12a3 3 0 1 1-4.24-4.24"/><path d="M1 1l22 22"/></svg>
                </button>
              </div>
            </div>
            <div class="field">
              <label for="password2">تأكيد كلمة المرور</label>
              <div class="password-field">
                <input type="password" id="password2" name="password2" placeholder="أعد كتابة كلمة المرور" minlength="8" required>
                <button type="button" class="toggle-pass" aria-label="إظهار كلمة المرور" data-target="password2">
                  <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
                  <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17.94 17.94A10.94 10.94 0 0 1 12 19c-7 0-11-7-11-7a20.6 20.6 0 0 1 5.06-5.94M9.9 4.24A10.4 10.4 0 0 1 12 4c7 0 11 7 11 7a20.6 20.6 0 0 1-3.22 4.19M14.12 14.12a3 3 0 1 1-4.24-4.24"/><path d="M1 1l22 22"/></svg>
                </button>
              </div>
            </div>

            <label class="agree-check">
              <input type="checkbox" required>
              <span>أقرّ بالتزامي بسياسات الاستخدام الداخلي وصلاحيات الدور الوظيفي الموكل إليّ في لوحة تحكم همم الحياة</span>
            </label>

            <div class="step-actions">
              <button type="button" class="btn btn-outline step-prev" data-prev="2">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                السابق
              </button>
              <button type="submit" class="btn btn-primary">إنشاء الحساب
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
              </button>
            </div>
          </div>

          <p id="formNote" style="display:none; color:var(--turquoise-600); font-weight:600; font-size:14.5px; text-align:center;">تم إنشاء الحساب بنجاح.</p>
        </form>

        <div class="auth-divider"><span>أو</span></div>

        <p class="auth-switch">لديك حساب بالفعل؟ <a asp-action="Login">تسجيل الدخول</a></p>
      </div>
    </div>
  </div>
</section>

@section Scripts {
    <script src="~/js/dashboard/admin-signup.js"></script>
}
