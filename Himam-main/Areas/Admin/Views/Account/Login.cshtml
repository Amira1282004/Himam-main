@{
    ViewData["Title"] = "تسجيل الدخول";
    ViewData["Description"] = "تسجيل الدخول إلى لوحة تحكم همم الحياة الخاصة بفريق العمل.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard/admin-login.css">
}

<section style="padding-top:50px;">
  <div class="container">
    <div class="auth-wrap">
      <div class="auth-card reveal">

        <form id="adminLoginForm" class="auth-form" asp-action="Login" method="post">
          @Html.AntiForgeryToken()
         <div class="logo"><img src="~/assets/logo-stacked-trim.png" alt="همم الحياة"></div>
          <div class="field">
            <label for="loginEmail">البريد الإلكتروني</label>
            <input type="email" id="loginEmail" name="loginEmail" placeholder="name@@himamalhayah.sa" required>
          </div>

          <div class="field">
            <label for="loginPassword">كلمة المرور</label>
            <div class="password-field">
              <input type="password" id="loginPassword" name="loginPassword" placeholder="أدخل كلمة المرور" required>
              <button type="button" class="toggle-pass" aria-label="إظهار كلمة المرور" data-target="loginPassword">
                <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17.94 17.94A10.94 10.94 0 0 1 12 19c-7 0-11-7-11-7a20.6 20.6 0 0 1 5.06-5.94M9.9 4.24A10.4 10.4 0 0 1 12 4c7 0 11 7 11 7a20.6 20.6 0 0 1-3.22 4.19M14.12 14.12a3 3 0 1 1-4.24-4.24"/><path d="M1 1l22 22"/></svg>
              </button>
            </div>
          </div>

          <div class="auth-row-between">
            <label class="agree-check" style="margin:0;">
              <input type="checkbox" name="rememberMe" value="true">
              <span>تذكرني</span>
            </label>
            <a href="#" class="auth-forgot">نسيت كلمة المرور؟</a>
          </div>

          <button type="submit" class="btn btn-primary auth-submit">تسجيل الدخول
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          </button>

          <p id="formNote" style="display:none; color:var(--turquoise-600); font-weight:600; font-size:14.5px; text-align:center;">تم تسجيل الدخول بنجاح.</p>
        </form>

        <div class="auth-divider"><span>أو</span></div>

        <p class="auth-switch">ليس لديك حساب؟ <a asp-action="Signup">إنشاء حساب</a></p>
      </div>
    </div>
  </div>
</section>

@section Scripts {
    <script src="~/js/dashboard/admin-login.js"></script>
}
