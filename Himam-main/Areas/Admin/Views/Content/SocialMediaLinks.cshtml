@model List<Himam_main.Models.SocialMediaLink>
@{
    ViewData["Title"] = "إدارة روابط التواصل الاجتماعي";
    Layout = "_ContentLayout";
}

<div class="content-page">
    <div class="content-header">
        <div class="header-content">
            <h1>إدارة روابط التواصل الاجتماعي</h1>
            <p>إضافة وتعديل وحذف روابط التواصل الاجتماعي</p>
        </div>
        <div class="header-actions">
            <a asp-action="CreateSocialMediaLink" class="btn-action btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                إضافة رابط جديد
            </a>
        </div>
    </div>

    <div class="content-body">
        @if (Model != null && Model.Count > 0)
        {
            <div class="items-grid">
                @foreach (var link in Model)
                {
                    <div class="item-card">
                        <div class="item-content">
                            <div class="item-header">
                                <h3 class="item-title">@link.Platform</h3>
                                <div class="item-status @(link.IsVisible ? "status-visible" : "status-hidden")">
                                    @(link.IsVisible ? "مرئي" : "مخفي")
                                </div>
                            </div>
                            <div class="item-link">@link.Url</div>
                            @if (!string.IsNullOrEmpty(link.PlatformName))
                            {
                                <div class="item-meta">
                                    <span class="meta-item">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                                        @link.PlatformName
                                    </span>
                                </div>
                            }
                            <div class="item-meta">
                                <span class="meta-item">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
                                    الترتيب: @link.SortOrder
                                </span>
                            </div>
                            <div class="item-actions">
                                <a asp-action="EditSocialMediaLink" asp-route-id="@link.Id" class="btn-sm btn-edit">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                    تعديل
                                </a>
                                <form asp-action="DeleteSocialMediaLink" asp-route-id="@link.Id" method="post" class="delete-form">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-sm btn-delete" onclick="return confirm('هل أنت متأكد من حذف هذا الرابط؟')">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                                        حذف
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                <h3>لا توجد روابط</h3>
                <p>ابدأ بإضافة رابط جديد لعرضه في الموقع</p>
                <a asp-action="CreateSocialMediaLink" class="btn-action btn-primary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    إضافة رابط جديد
                </a>
            </div>
        }
    </div>
</div>
