@model List<Himam_main.Models.CompanyValue>
@{
    ViewData["Title"] = "إدارة قيم الشركة";
    Layout = "_ContentLayout";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title">إدارة قيم الشركة</h3>
                    <a asp-action="CreateCompanyValue" class="btn btn-primary">إضافة قيمة جديدة</a>
                </div>
                <div class="card-body">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>العنوان</th>
                                <th>المحتوى</th>
                                <th>الترتيب</th>
                                <th>الحالة</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var value in Model)
                            {
                                <tr>
                                    <td>@value.Title</td>
                                    <td>@(value.Content?.Length > 100 ? value.Content.Substring(0, 100) + "..." : value.Content)</td>
                                    <td>@value.SortOrder</td>
                                    <td>
                                        @if (value.IsVisible)
                                        {
                                            <span class="badge bg-success">مرئي</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">مخفي</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="EditCompanyValue" asp-route-id="@value.Id" class="btn btn-sm btn-info">تعديل</a>
                                        <form asp-action="DeleteCompanyValue" asp-route-id="@value.Id" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('هل أنت متأكد من الحذف؟')">حذف</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
