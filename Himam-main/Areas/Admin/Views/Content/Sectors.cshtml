@model List<Himam_main.Models.Sector>
@{
    ViewData["Title"] = "إدارة القطاعات";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title">إدارة القطاعات</h3>
                    <a asp-action="CreateSector" class="btn btn-primary">إضافة قطاع جديد</a>
                </div>
                <div class="card-body">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>العنوان</th>
                                <th>الصورة</th>
                                <th>الترتيب</th>
                                <th>الحالة</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sector in Model)
                            {
                                <tr>
                                    <td>@sector.Title</td>
                                    <td>@sector.Image</td>
                                    <td>@sector.SortOrder</td>
                                    <td>
                                        @if (sector.IsVisible)
                                        {
                                            <span class="badge bg-success">مرئي</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">مخفي</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="EditSector" asp-route-id="@sector.Id" class="btn btn-sm btn-info">تعديل</a>
                                        <form asp-action="DeleteSector" asp-route-id="@sector.Id" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('هل أنت متأكد من الحذف؟')">حذف</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
