@model Himam_main.Models.ContactInfo
@{
    ViewData["Title"] = "إدارة معلومات التواصل";
    Layout = "_ContentLayout";
}

<div class="content-page">
    <div class="content-header">
        <div class="header-content">
            <h1>إدارة معلومات التواصل</h1>
            <p>تحرير معلومات التواصل مع العملاء</p>
        </div>
        <div class="header-actions">
            <a asp-action="Index" asp-controller="Dashboard" class="btn-action btn-secondary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                عودة
            </a>
        </div>
    </div>

    <div class="content-body">
        <form asp-action="ContactInfo" method="post" class="edit-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="form-section">
                <div class="section-title">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    معلومات التواصل الأساسية
                </div>
                
                <div class="form-grid">
                    <div class="form-group">
                        <label asp-for="Email" class="form-label">البريد الإلكتروني</label>
                        <input asp-for="Email" class="form-input" type="email" placeholder="example@company.com" />
                        <span asp-validation-for="Email" class="form-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Phone" class="form-label">رقم الهاتف</label>
                        <input asp-for="Phone" class="form-input" placeholder="+966 XX XXX XXXX" />
                        <span asp-validation-for="Phone" class="form-error"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Address" class="form-label">العنوان</label>
                    <textarea asp-for="Address" class="form-input" rows="3" placeholder="أدخل العنوان الكامل"></textarea>
                    <span asp-validation-for="Address" class="form-error"></span>
                </div>
            </div>

            <div class="form-section">
                <div class="section-title">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    معلومات إضافية
                </div>
                
                <div class="form-group">
                    <label asp-for="WorkingHours" class="form-label">أوقات العمل</label>
                    <input asp-for="WorkingHours" class="form-input" placeholder="مثال: الأحد - الخميس: 9 ص - 5 م" />
                    <span asp-validation-for="WorkingHours" class="form-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MapEmbedUrl" class="form-label">رابط الخريطة المضمن</label>
                    <textarea asp-for="MapEmbedUrl" class="form-input" rows="3" placeholder="أدخل كود embed للخريطة"></textarea>
                    <span asp-validation-for="MapEmbedUrl" class="form-error"></span>
                    <small class="form-hint">يمكنك الحصول على رابط الخريطة من Google Maps</small>
                </div>
            </div>

            <div class="form-section">
                <div class="section-title">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                    إعدادات العرض
                </div>
                
                <div class="form-toggles">
                    <div class="toggle-item">
                        <label class="toggle-label">
                            <input asp-for="IsVisible" type="checkbox" class="toggle-input" />
                            <span class="toggle-slider"></span>
                            <span class="toggle-text">إظهار معلومات التواصل</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-action btn-primary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                    حفظ التغييرات
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
