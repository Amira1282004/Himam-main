              معاينة الموقع
            </a>
          </div>

          <div class="page-list">

            <div class="page-row">
              <div class="page-row-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 11l9-8 9 8"/><path d="M5 10v10a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V10"/></svg></div>
              <div class="page-row-info">
                <h4>الرئيسية</h4>
                <span class="slug">index.html</span>
              </div>
              <div class="page-row-meta">آخر تحديث: سارة القحطاني<br>قبل 3 أيام</div>
              <span class="status-badge status-active">منشور</span>
              <div class="page-row-actions">
                <button type="button" class="btn btn-outline btn-sm page-edit-toggle" data-target="edit-home">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
                  تعديل المحتوى
