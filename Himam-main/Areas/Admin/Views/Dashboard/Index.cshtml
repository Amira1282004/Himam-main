                <div style="display:flex; align-items:center; gap:14px;">
                  <button type="submit" class="btn btn-primary btn-sm">حفظ التغييرات</button>
                  <p class="page-save-note" style="display:none; color:var(--turquoise-600); font-weight:600; font-size:13px;">تم حفظ التعديلات بنجاح.</p>
                </div>
              </form>
            </div>

          </div>
        </div>
      </section>

      <section class="dash-section" id="sec-users">
        <div class="dash-panel">
          <div class="dash-panel-head">
            <div><h2>مستخدمو لوحة التحكم</h2><p>جميع الحسابات التي تملك وصولاً إلى لوحة تحكم همم الحياة</p></div>
            <button class="btn btn-primary btn-sm" onclick="dashNavigate('admins')">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
              إضافة مستخدم
            </button>
          </div>
          <div class="chip-row" style="margin-bottom:18px;">
            <button class="chip active">الكل (@Model.TotalUsers)</button>
            <button class="chip">المدير الأعلى (@superCount)</button>
            <button class="chip">مدير الموقع (@managerCount)</button>
            <button class="chip">محرر المحتوى (@editorCount)</button>
            <button class="chip">خدمة العملاء (@supportCount)</button>
          </div>
          <div class="dash-table-wrap">
            <table class="dash-table">
              <thead>
                <tr><th>المستخدم</th><th>الدور</th><th>الحالة</th><th>تاريخ الإنشاء</th><th></th></tr>
              </thead>
              <tbody>
                @foreach (var user in Model.Users)
                {
                  var avatarColor = user.RoleBadgeClass switch
                  {
                    "role-super" => "var(--purple)",
                    "role-manager" => "var(--turquoise-600)",
                    "role-editor" => "var(--gold)",
                    _ => "var(--charcoal)"
                  };
                  <tr>
                    <td>
                      <div class="cell-user">
                        <span class="avatar" style="background:@avatarColor;">@user.Initials</span>
                        <div>
                          <div class="name">@user.Username</div>
                          <div class="email">@user.Email</div>
                        </div>
                      </div>
                    </td>
                    <td><span class="role-badge @user.RoleBadgeClass">@user.RoleNameAr</span></td>
                    <td><span class="status-badge status-active">نشط</span></td>
                    <td>@(user.CreatedAt?.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ar-SA")) ?? "—")</td>
                    <td>
                      <div class="row-actions">
                        @if (user.IsCurrentUser)
                        {
                          <button type="button" class="icon-action profile-trigger" title="تعديل الملف الشخصي">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
                          </button>
                          @if (user.RoleName == "Super Admin")
                          {
                            <button class="icon-action" disabled title="لا يمكن حذف المدير الأعلى"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6h14z"/></svg></button>
                          }
                        }
                      </div>
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="dash-section" id="sec-permissions">
        <div class="dash-panel">
          <div class="dash-panel-head">
            <div><h2>مصفوفة الصلاحيات</h2><p>الصلاحيات الممنوحة لكل دور من أدوار العمل في لوحة التحكم</p></div>
          </div>

          <div class="matrix-legend">
            <span><span class="legend-dot" style="background:#1DB1A4;"></span> ممنوحة بالكامل</span>
            <span><span class="legend-dot" style="background:var(--gold);"></span> مشروطة</span>
            <span><span class="legend-dot" style="background:var(--charcoal);"></span> غير ممنوحة</span>
          </div>

          <div class="dash-table-wrap">
            <table class="matrix">
              <thead>
                <tr>
                  <th class="cap-col">الصلاحية</th>
                  <th><span class="role-badge role-super">المدير الأعلى</span></th>
                  <th><span class="role-badge role-manager">مدير الموقع</span></th>
                  <th><span class="role-badge role-editor">محرر المحتوى</span></th>
                  <th><span class="role-badge role-support">خدمة العملاء</span></th>
                </tr>
              </thead>
              <tbody id="matrixBody">
              </tbody>
            </table>
          </div>

          <div class="matrix-note">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 9v4M12 17h.01"/><circle cx="12" cy="12" r="10"/></svg>
            <span>مدير الموقع لا يستطيع حذف حساب المدير الأعلى أو تغيير ملكية الموقع، بصرف النظر عن أي صلاحيات أخرى ممنوحة له.</span>
          </div>

          <div class="toggle-row">
            <div>
              <div class="t-title">صلاحية نشر المحتوى مباشرةً لمحرر المحتوى</div>
              <div class="t-desc">افتراضيًا، يحفظ محرر المحتوى مسودة فقط وينتظر اعتماد مدير الموقع أو المدير الأعلى. تفعيل هذا الخيار يسمح له بالنشر مباشرة دون مراجعة.</div>
            </div>
            <label class="switch">
              <input type="checkbox" id="publishPermissionToggle">
              <span class="slider"></span>
            </label>
          </div>
        </div>
      </section>

      <section class="dash-section" id="sec-admins">
        <div class="grid-2col">
          <div class="dash-panel">
            <div class="dash-panel-head">
              <div><h2>حسابات المديرين</h2><p>الحسابات التي تملك صلاحيات إدارية (المدير الأعلى ومديرو الموقع)</p></div>
            </div>
            <div class="dash-table-wrap">
              <table class="dash-table">
                <thead><tr><th>المستخدم</th><th>الدور</th><th>تاريخ الإنشاء</th><th></th></tr></thead>
                <tbody>
                  @foreach (var user in Model.Users.Where(u => u.RoleName is "Super Admin" or "Site Manager"))
                  {
                    var avatarColor = user.RoleBadgeClass == "role-super" ? "var(--purple)" : "var(--turquoise-600)";
                    <tr>
                      <td><div class="cell-user"><span class="avatar" style="background:@avatarColor;">@user.Initials</span><div><div class="name">@user.Username</div><div class="email">@user.Email</div></div></div></td>
                      <td><span class="role-badge @user.RoleBadgeClass">@user.RoleNameAr</span></td>
                      <td>@(user.CreatedAt?.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ar-SA")) ?? "—")</td>
                      <td>
                        @if (user.RoleName == "Super Admin")
                        {
                          <button class="icon-action" disabled title="لا يمكن حذف المدير الأعلى"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6h14z"/></svg></button>
                        }
                      </td>
                    </tr>
                  }
                </tbody>
              </table>
            </div>
          </div>

          <div class="dash-panel">
            <div class="dash-panel-head"><div><h2>إنشاء حساب مدير</h2><p>يقتصر إنشاء وحذف حسابات المديرين على المدير الأعلى</p></div></div>
            <form onsubmit="event.preventDefault(); document.getElementById('adminFormNote').style.display='block'; this.reset();" style="display:flex; flex-direction:column; gap:16px;">
              <div class="field">
                <label for="adminName">الاسم الكامل</label>
                <input type="text" id="adminName" placeholder="اسم المدير الجديد" required>
              </div>
              <div class="field">
                <label for="adminEmail">البريد الإلكتروني</label>
                <input type="email" id="adminEmail" placeholder="name@@himamalhayah.sa" required>
              </div>
              <div class="field">
                <label for="adminRole">الدور</label>
                <select id="adminRole">
                  <option value="manager">مدير الموقع</option>
                  <option value="editor">محرر المحتوى</option>
                  <option value="support">خدمة العملاء</option>
                </select>
                <span class="field-hint">لا يمكن إنشاء أكثر من حساب مدير أعلى واحد.</span>
              </div>
              <button type="submit" class="btn btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                إنشاء الحساب وإرسال دعوة
              </button>
              <p id="adminFormNote" style="display:none; color:var(--turquoise-600); font-weight:600; font-size:13.5px;">تم إنشاء الحساب، وسيصل رابط تفعيل إلى البريد الإلكتروني المُدخل.</p>
            </form>
          </div>
        </div>
      </section>

      <section class="dash-section" id="sec-settings">
        <div class="dash-panel">
          <div class="dash-panel-head"><div><h2>الإعدادات العامة</h2><p>بيانات الموقع الأساسية وأوقات العمل ووضع الصيانة</p></div></div>
          <form onsubmit="event.preventDefault(); document.getElementById('settingsFormNote').style.display='block';" style="display:flex; flex-direction:column; gap:18px;">
            <div class="settings-grid">
              <div class="field"><label for="siteName">اسم الموقع</label><input type="text" id="siteName" value="همم الحياة"></div>
              <div class="field"><label for="siteTagline">الشعار النصي</label><input type="text" id="siteTagline" value="من الفكرة إلى التجربة"></div>
              <div class="field"><label for="siteEmail">البريد الإلكتروني العام</label><input type="email" id="siteEmail" value="info@@himamalhayah.sa"></div>
              <div class="field"><label for="sitePhone">رقم الجوال العام</label><input type="tel" id="sitePhone" value="0535105327"></div>
              <div class="field" style="grid-column:1/-1;"><label for="siteAddress">العنوان</label><input type="text" id="siteAddress" value="جدة، حي مشرفة، شارع عين الوهيط، مبنى 3654"></div>
            </div>

            <div class="toggle-row">
              <div><div class="t-title">وضع الصيانة</div><div class="t-desc">عند التفعيل، يظهر للزوار إشعار بأن الموقع قيد التحديث، مع بقاء وصول فريق العمل متاحًا.</div></div>
              <label class="switch"><input type="checkbox"><span class="slider"></span></label>
            </div>
            <div class="toggle-row">
              <div><div class="t-title">تنبيهات النماذج بالبريد الإلكتروني</div><div class="t-desc">إرسال بريد فوري لفريق خدمة العملاء عند استلام أي نموذج تواصل جديد.</div></div>
              <label class="switch"><input type="checkbox" checked><span class="slider"></span></label>
            </div>

            <div><button type="submit" class="btn btn-primary">حفظ التغييرات</button></div>
            <p id="settingsFormNote" style="display:none; color:var(--turquoise-600); font-weight:600; font-size:13.5px;">تم حفظ الإعدادات بنجاح.</p>
          </form>
        </div>
      </section>

      <section class="dash-section" id="sec-security">
        <div class="dash-panel">
          <div class="dash-panel-head">
            <div><h2>السجلات الأمنية</h2><p>سجل بجميع عمليات الدخول والتغييرات الحساسة في لوحة التحكم</p></div>
            <button class="btn btn-outline btn-sm">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 15V3M7 10l5 5 5-5"/><path d="M21 21H3"/></svg>
              تصدير السجل
            </button>
          </div>
          <div class="dash-table-wrap">
            <table class="dash-table">
              <thead><tr><th>الوقت</th><th>المستخدم</th><th>الإجراء</th><th>عنوان IP</th><th>الحالة</th></tr></thead>
              <tbody>
                <tr><td>اليوم، 10:42 ص</td><td>ريم الشهراني</td><td>تسجيل دخول ناجح</td><td>91.74.12.6</td><td><span class="log-status ok">ناجح</span></td></tr>
                <tr><td>اليوم، 09:15 ص</td><td>نورة المطيري</td><td>محاولة دخول بجهاز جديد</td><td>178.20.4.91</td><td><span class="log-status warn">بحاجة تحقق</span></td></tr>
                <tr><td>أمس، 6:40 م</td><td>فيصل العتيبي</td><td>تعديل صفحة «خدماتنا»</td><td>91.74.12.19</td><td><span class="log-status ok">ناجح</span></td></tr>
                <tr><td>أمس، 4:12 م</td><td>سارة القحطاني</td><td>حفظ مسودة جديدة</td><td>91.74.8.201</td><td><span class="log-status ok">ناجح</span></td></tr>
                <tr><td>قبل يومين</td><td>خالد العمري</td><td>3 محاولات دخول فاشلة</td><td>212.66.3.4</td><td><span class="log-status warn">تم الإيقاف مؤقتًا</span></td></tr>
                <tr><td>قبل 4 أيام</td><td>ريم الشهراني</td><td>تغيير صلاحيات «محرر المحتوى»</td><td>91.74.12.6</td><td><span class="log-status ok">ناجح</span></td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="dash-section" id="sec-integrations">
        <div class="dash-panel">
          <div class="dash-panel-head"><div><h2>إدارة التكاملات</h2><p>الخدمات الخارجية المرتبطة بموقع همم الحياة</p></div></div>
          <div class="integration-grid">

            <div class="integration-card">
              <div class="integration-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></div>
              <div class="integration-body">
                <h4>خرائط جوجل</h4>
                <p>عرض موقع همم الحياة في صفحة التواصل</p>
                <div class="integration-foot"><span class="status-badge status-active">متصل</span><button class="btn btn-outline btn-sm">إدارة</button></div>
              </div>
            </div>

            <div class="integration-card">
              <div class="integration-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h16v16H4z" opacity="0"/><path d="M3 6l9 6 9-6"/><rect x="3" y="5" width="18" height="14" rx="2"/></svg></div>
              <div class="integration-body">
                <h4>بريد النماذج (SMTP)</h4>
                <p>إرسال إشعارات نماذج التواصل تلقائيًا</p>
                <div class="integration-foot"><span class="status-badge status-active">متصل</span><button class="btn btn-outline btn-sm">إدارة</button></div>
              </div>
            </div>

            <div class="integration-card">
              <div class="integration-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/></svg></div>
              <div class="integration-body">
                <h4>تحليلات الموقع</h4>
                <p>تتبّع الزيارات وسلوك المستخدمين</p>
                <div class="integration-foot"><span class="status-badge status-active">متصل</span><button class="btn btn-outline btn-sm">إدارة</button></div>
              </div>
            </div>

            <div class="integration-card">
              <div class="integration-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></div>
              <div class="integration-body">
                <h4>بوابة الحجوزات والدفع</h4>
                <p>ربط نماذج الحجز ببوابة الدفع الإلكتروني</p>
                <div class="integration-foot"><span class="status-badge status-active">متصل</span><button class="btn btn-outline btn-sm">إدارة</button></div>
              </div>
            </div>

            <div class="integration-card">
              <div class="integration-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg></div>
              <div class="integration-body">
                <h4>حسابات التواصل الاجتماعي</h4>
                <p>عرض تلقائي لآخر المنشورات في الموقع</p>
                <div class="integration-foot"><span class="status-badge status-pending">بانتظار الربط</span><button class="btn btn-primary btn-sm">ربط الحساب</button></div>
              </div>
            </div>

          </div>
        </div>
      </section>

    
