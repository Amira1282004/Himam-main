@model Himam_main.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "لوحة تحكم المدير الأعلى";
    ViewData["Description"] = "لوحة تحكم المدير الأعلى في همم الحياة: إدارة المستخدمين والصلاحيات والإعدادات والسجلات الأمنية والتكاملات.";
    Layout = "_DashboardLayout";

    var superCount = Model.UsersByRole.GetValueOrDefault("Super Admin", 0);
    var managerCount = Model.UsersByRole.GetValueOrDefault("Site Manager", 0);
    var editorCount = Model.UsersByRole.GetValueOrDefault("Content Editor", 0);
    var supportCount = Model.UsersByRole.GetValueOrDefault("Customer Service", 0);
    var totalForChart = Math.Max(Model.TotalUsers, 1);
    var superPct = superCount * 100.0 / totalForChart;
    var managerPct = managerCount * 100.0 / totalForChart;
    var editorPct = editorCount * 100.0 / totalForChart;
    var supportPct = supportCount * 100.0 / totalForChart;
    var chartGradient = $"conic-gradient(var(--purple) 0% {superPct:F1}%, var(--turquoise) {superPct:F1}% {superPct + managerPct:F1}%, var(--gold) {superPct + managerPct:F1}% {superPct + managerPct + editorPct:F1}%, var(--charcoal) {superPct + managerPct + editorPct:F1}% 100%)";
}



      <section class="dash-section active" id="sec-overview">
        <div class="kpi-grid">
          <div class="kpi-card">
            <div class="kpi-top">
              <div class="kpi-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div>
              <span class="kpi-trend up">+3 هذا الشهر</span>
            </div>
            <div class="kpi-chart-row">
              <div class="donut" style="background:@chartGradient;">
                <span class="donut-label">@Model.TotalUsers</span>
              </div>
              <div class="kpi-legend">
                <span><i style="background:var(--purple);"></i>مدير أعلى @superCount</span>
                <span><i style="background:var(--turquoise);"></i>مدير موقع @managerCount</span>
                <span><i style="background:var(--gold);"></i>محرر محتوى @editorCount</span>
                <span><i style="background:var(--charcoal);"></i>خدمة عملاء @supportCount</span>
              </div>
            </div>
            <div class="kpi-label">مستخدمو لوحة التحكم حسب الدور</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-top">
              <div class="kpi-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h16v16H4z" opacity="0"/><path d="M3 6l9 6 9-6"/><rect x="3" y="5" width="18" height="14" rx="2"/></svg></div>
              <span class="kpi-trend warn">7 قيد المراجعة</span>
            </div>
            <div class="mini-bars" aria-label="طلبات التواصل خلال آخر 7 أيام">
              <div class="bar"><i style="height:40%; background:var(--purple);"></i></div>
              <div class="bar"><i style="height:60%; background:var(--purple);"></i></div>
              <div class="bar"><i style="height:80%; background:var(--purple);"></i></div>
              <div class="bar"><i style="height:60%; background:var(--purple);"></i></div>
              <div class="bar"><i style="height:100%; background:var(--purple);"></i></div>
              <div class="bar"><i style="height:80%; background:var(--purple);"></i></div>
              <div class="bar hl"><i style="height:60%;"></i></div>
            </div>
            <div class="kpi-label">طلبات تواصل هذا الأسبوع — إجمالي 24</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-top">
              <div class="kpi-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/></svg></div>
              <span class="kpi-trend up">سليم</span>
            </div>
            <div class="kpi-chart-row">
              <div class="donut" style="background:conic-gradient(var(--turquoise) 0% 100%);">
                <span class="donut-label" style="color:var(--turquoise-600);">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" style="width:20px; height:20px;"><path d="M4 12l5 5L20 6"/></svg>
                </span>
              </div>
              <div class="kpi-legend"><span><i style="background:var(--turquoise);"></i>0 تنبيهات نشطة خلال آخر 30 يومًا</span></div>
            </div>
            <div class="kpi-label">تنبيهات أمنية نشطة</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-top">
              <div class="kpi-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 3H5a2 2 0 0 0-2 2v4M15 3h4a2 2 0 0 1 2 2v4M9 21H5a2 2 0 0 1-2-2v-4M15 21h4a2 2 0 0 0 2-2v-4"/><circle cx="12" cy="12" r="3"/></svg></div>
              <span class="kpi-trend up">4 متصلة</span>
            </div>
            <div class="kpi-chart-row">
              <div class="donut" style="background:conic-gradient(var(--purple) 0% 80%, var(--mist-2) 80% 100%);">
                <span class="donut-label">4/5</span>
              </div>
              <div class="kpi-legend">
                <span><i style="background:var(--purple);"></i>متصلة</span>
                <span><i style="background:var(--mist-2); border:1px solid var(--line);"></i>بانتظار الربط</span>
              </div>
            </div>
            <div class="kpi-label">التكاملات النشطة</div>
          </div>
        </div>

        <div class="chart-panel-grid">
          <div class="dash-panel" style="margin-bottom:0;">
            <div class="dash-panel-head"><div><h2>الزيارات خلال آخر 7 أيام</h2><p>عدد زيارات الموقع يوميًا</p></div></div>
            <div class="line-chart-wrap">
              <svg viewBox="0 0 560 160" preserveAspectRatio="none">
                <defs>
                  <linearGradient id="visitsFill" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="var(--turquoise)" stop-opacity=".35"/>
                    <stop offset="100%" stop-color="var(--turquoise)" stop-opacity="0"/>
                  </linearGradient>
                </defs>
                <path d="M0,120 93,95 187,135 280,70 373,100 467,45 560,30 560,160 0,160 Z" fill="url(#visitsFill)"/>
                <polyline points="0,120 93,95 187,135 280,70 373,100 467,45 560,30" fill="none" stroke="var(--turquoise)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="0" cy="120" r="4" fill="var(--turquoise)"/>
                <circle cx="93" cy="95" r="4" fill="var(--turquoise)"/>
                <circle cx="187" cy="135" r="4" fill="var(--turquoise)"/>
                <circle cx="280" cy="70" r="4" fill="var(--turquoise)"/>
                <circle cx="373" cy="100" r="4" fill="var(--turquoise)"/>
                <circle cx="467" cy="45" r="4" fill="var(--turquoise)"/>
                <circle cx="560" cy="30" r="5" fill="var(--purple-ink)"/>
              </svg>
            </div>
            <div class="chart-axis-labels">
              <span>السبت</span><span>الأحد</span><span>الاثنين</span><span>الثلاثاء</span><span>الأربعاء</span><span>الخميس</span><span>الجمعة</span>
            </div>
          </div>

          <div class="dash-panel" style="margin-bottom:0;">
            <div class="dash-panel-head"><div><h2>نماذج التواصل حسب الحالة</h2></div></div>
            <div class="status-bars">
              <div class="status-bar-row">
                <div class="row-top"><span>جديد</span><b>9</b></div>
                <div class="status-bar-track"><div class="status-bar-fill" style="width:37%; background:var(--purple);"></div></div>
              </div>
              <div class="status-bar-row">
                <div class="row-top"><span>قيد المراجعة</span><b>7</b></div>
                <div class="status-bar-track"><div class="status-bar-fill" style="width:29%; background:var(--gold);"></div></div>
              </div>
              <div class="status-bar-row">
                <div class="row-top"><span>تم الرد</span><b>8</b></div>
                <div class="status-bar-track"><div class="status-bar-fill" style="width:33%; background:var(--turquoise);"></div></div>
              </div>
            </div>
          </div>
        </div>

        <div class="grid-2col">
          <div class="dash-panel">
            <div class="dash-panel-head">
              <div><h2>آخر النشاطات</h2><p>أحدث التحديثات على الموقع ولوحة التحكم</p></div>
            </div>
            <div class="activity-list">
              <div class="activity-item">
                <span class="activity-dot" style="background:var(--purple);"></span>
                <div><p><strong>سارة القحطاني</strong> نشرت خبرًا جديدًا في «أخبار وفعاليات»</p><div class="t">قبل 20 دقيقة</div></div>
              </div>
              <div class="activity-item">
                <span class="activity-dot" style="background:var(--turquoise);"></span>
                <div><p><strong>مدير الموقع</strong> راجع 3 نماذج تواصل جديدة</p><div class="t">قبل ساعتين</div></div>
              </div>
              <div class="activity-item">
                <span class="activity-dot" style="background:var(--gold);"></span>
                <div><p>محرر محتوى رفع مسودة «صناعة الفعاليات والمناسبات» بانتظار الاعتماد</p><div class="t">أمس، 4:12 م</div></div>
              </div>
              <div class="activity-item">
                <span class="activity-dot" style="background:var(--charcoal);"></span>
                <div><p>تسجيل دخول جديد لحساب <strong>خدمة العملاء</strong> من جهاز غير معروف</p><div class="t">أمس، 11:03 ص</div></div>
              </div>
            </div>
          </div>

          <div class="dash-panel">
            <div class="dash-panel-head"><div><h2>إجراءات سريعة</h2></div></div>
            <div style="display:flex; flex-direction:column; gap:10px;">
              <button class="btn btn-outline" style="justify-content:flex-start;" onclick="dashNavigate('admins')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                إنشاء حساب مدير جديد
              </button>
              <button class="btn btn-outline" style="justify-content:flex-start;" onclick="dashNavigate('permissions')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/></svg>
                مراجعة مصفوفة الصلاحيات
              </button>
              <button class="btn btn-outline" style="justify-content:flex-start;" onclick="dashNavigate('security')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9.5 12l1.8 1.8L15 10"/><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/></svg>
                فتح السجلات الأمنية
              </button>
            </div>
          </div>
        </div>
      </section>

      <section class="dash-section" id="sec-pages">
        <div class="dash-panel">
          <div class="dash-panel-head">
