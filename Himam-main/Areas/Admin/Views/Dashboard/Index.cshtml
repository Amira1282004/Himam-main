              </div>
              <form class="page-editor page-editor-form" id="edit-home">
                <div class="page-editor-grid">
                  <div class="field"><label>عنوان الصفحة الرئيسية (Hero)</label><input type="text" value="نصنع تجارب ترفيهية... لأن الحياة حق للجميع"></div>
