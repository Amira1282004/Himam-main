@model Himam_main.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "همم الحياة";
    ViewData["Description"] = "شركة سعودية متخصصة في صناعة الفعاليات وتطوير البرامج والتجارب المتكاملة للجهات الحكومية والقطاع الخاص والمنظمات غير الربحية.";
    ViewData["Active"] = "index";
}

@section Styles {
    <link rel="stylesheet" href="~/css/user/index.css" />
    <link rel="stylesheet" href="~/css/user/splash.css" />
}

<div id="himamSplash" class="splash-screen" role="presentation" aria-hidden="true">
  <div class="splash-panel splash-panel--left"></div>
  <div class="splash-panel splash-panel--right"></div>
  <div class="splash-glow splash-glow--a"></div>
  <div class="splash-glow splash-glow--b"></div>
  <div class="splash-logo-wrap">
    <img src="~/assets/logo-stacked-trim.png" alt="همم الحياة" class="splash-logo">
  </div>
</div>
<script src="~/js/user/splash.js"></script>

@if (Model.HeroSection != null && Model.HeroSection.IsVisible)
{
    <section class="home-hero">
      @if (Model.HeroSection.IsVideoEnabled && !string.IsNullOrEmpty(Model.HeroSection.YoutubeVideoId))
      {
        <div class="hero-video-layer" aria-hidden="true">
          <iframe id="heroYtBg" class="hero-yt-bg"
            src="https://www.youtube-nocookie.com/embed/@Model.HeroSection.YoutubeVideoId?enablejsapi=1&autoplay=1&mute=1&loop=1&playlist=@Model.HeroSection.YoutubeVideoId&controls=0&showinfo=0&rel=0&modestbranding=1&iv_load_policy=3&playsinline=1&disablekb=1"
            title="همم الحياة - فيديو توضيحي"
            frameborder="0" width="100%" height="100%"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin">
          </iframe>
          <div class="hero-overlay"></div>
        </div>
      }

      <div class="container home-hero-inner">
        @if (!string.IsNullOrEmpty(Model.HeroSection.Subtitle))
        {
            <div class="eyebrow-1">@Model.HeroSection.Subtitle</div>
        }
        <h1>@Model.HeroSection.Title</h1>

        @if (!string.IsNullOrEmpty(Model.HeroSection.CtaText) && !string.IsNullOrEmpty(Model.HeroSection.CtaLink))
        {
            <div class="hero-cta-row">
              <a href="@Model.HeroSection.CtaLink" class="btn btn-primary">@Model.HeroSection.CtaText
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
              </a>
            </div>
        }
      </div>

    </section>
}
<section class="section-sm bg-ink" style="padding-block:0;">

</section>

@if (Model.AboutSection != null && Model.AboutSection.IsVisible)
{
    <section class="bg-mist">
      <div class="container">
        <div class="about-teaser">
          <div class="about-teaser-content reveal">
            @if (!string.IsNullOrEmpty(Model.AboutSection.Eyebrow))
            {
                <div class="eyebrow">@Model.AboutSection.Eyebrow</div>
            }
            <h2>@Model.AboutSection.Title</h2>
            <p>@Model.AboutSection.Description</p>
            @if (!string.IsNullOrEmpty(Model.AboutSection.AdditionalDescription))
            {
                <p>@Model.AboutSection.AdditionalDescription</p>
            }
          </div>
          @if (!string.IsNullOrEmpty(Model.AboutSection.ChairmanImage))
          {
              <div class="about-teaser-media reveal">
                <div class="chairman-frame">
                  <img src="@Model.AboutSection.ChairmanImage" alt="@Model.AboutSection.ChairmanName - @Model.AboutSection.ChairmanTitle">
                </div>
                @if (!string.IsNullOrEmpty(Model.AboutSection.ChairmanName) || !string.IsNullOrEmpty(Model.AboutSection.ChairmanTitle))
                {
                    <div class="chairman-tag">
                      @if (!string.IsNullOrEmpty(Model.AboutSection.ChairmanName))
                      {
                          <strong>@Model.AboutSection.ChairmanName</strong>
                      }
                      @if (!string.IsNullOrEmpty(Model.AboutSection.ChairmanTitle))
                      {
                          <span>@Model.AboutSection.ChairmanTitle</span>
                      }
                    </div>
                }
              </div>
          }
        </div>
      </div>
    </section>
}


@if (Model.Sectors.Any())
{
    <section id="sectors">
      <div class="container">
        <div class="head-row reveal">
          <h2>قطاعات الأعمال</h2>
        </div>
      </div>
      <div class="container sectors-scroll-wrap">
        <button type="button" class="sectors-arrow sectors-arrow--prev" data-dir="prev" aria-label="القطاعات السابقة">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 6l6 6-6 6"/></svg>
        </button>
        <div class="sectors-scroll reveal">

          @foreach (var sector in Model.Sectors)
          {
              <div class="sector-card">
                <div class="flip-inner">
                  <div class="flip-front">
                    @if (!string.IsNullOrEmpty(sector.Image))
                    {
                        <img class="sector-img" src="@sector.Image" alt="@sector.Title" loading="lazy">
                    }
                    <div class="sector-front-overlay"></div>
                    <div class="sector-front-label">
                      <h3>@sector.Title</h3>
                    </div>
                  </div>
                  <div class="flip-back">
                    <h3>@sector.Title</h3>
                    <p>@sector.Description</p>
                  </div>
                </div>
              </div>
          }
        </div>
        <button type="button" class="sectors-arrow sectors-arrow--next" data-dir="next" aria-label="القطاعات التالية">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 6l-6 6 6 6"/></svg>
        </button>
      </div>
    </section>
}

<section class="bg-mist">
  <div class="container">
    <div class="head-row reveal">
      <h2>أحداث و فعاليات همم الحياة</h2>
      <a href="@Url.Action("News","Home",new{area="User"})" class="btn btn-outline">عرض الكل
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </a>
    </div>
    <div class="grid grid-3">

      <div class="news-card reveal">
        <div class="news-thumb news-thumb--1" data-video-id="AFF3UljE3GI" role="button" tabindex="0" aria-label="تشغيل فيديو: همم الحياة تشارك في فعاليات موسم الرياض">
          <img src="https://img.youtube.com/vi/AFF3UljE3GI/hqdefault.jpg" alt="" loading="lazy">
          <button type="button" class="news-play" aria-hidden="true" tabindex="-1">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </button>
        </div>
        <a href="@Url.Action("NewsSingle","Home",new{area="User",id=1})" class="news-card-body">
          <span class="news-date">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            12 يوليو 2026
          </span>
          <h3>همم الحياة تشارك في فعاليات موسم الرياض بتجربة تفاعلية جديدة تجمع بين الإبداع والتقنية</h3>
          <span class="news-more">اقرأ المزيد
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          </span>
        </a>
      </div>

      <div class="news-card reveal">
        <div class="news-thumb news-thumb--2" data-video-id="5bgT4uaJYgg" role="button" tabindex="0" aria-label="تشغيل فيديو: إطلاق برنامج تدريبي لتنمية القدرات">
          <img src="https://img.youtube.com/vi/5bgT4uaJYgg/hqdefault.jpg" alt="" loading="lazy">
          <button type="button" class="news-play" aria-hidden="true" tabindex="-1">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </button>
        </div>
        <a href="@Url.Action("NewsSingle","Home",new{area="User",id=2})" class="news-card-body">
          <span class="news-date">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            28 يونيو 2026
          </span>
          <h3>إطلاق برنامج تدريبي لتنمية القدرات في قطاع الفعاليات</h3>
          <span class="news-more">اقرأ المزيد
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          </span>
        </a>
      </div>

      <div class="news-card reveal">
        <div class="news-thumb news-thumb--3" data-video-id="D8sKqJ8xjvM" role="button" tabindex="0" aria-label="تشغيل فيديو: توقيع شراكة استراتيجية">
          <img src="https://img.youtube.com/vi/D8sKqJ8xjvM/hqdefault.jpg" alt="" loading="lazy">
          <button type="button" class="news-play" aria-hidden="true" tabindex="-1">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </button>
        </div>
        <a href="@Url.Action("NewsSingle","Home",new{area="User",id=3})" class="news-card-body">
          <span class="news-date">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            15 يونيو 2026
          </span>
          <h3>توقيع شراكة استراتيجية مع قطاع السياحة والضيافة</h3>
          <span class="news-more">اقرأ المزيد
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<section class="bg-ink">
  <div class="container">
    <div class="event-head reveal">
      <div class="eyebrow">الحدث الأكبر القادم</div>
    </div>
    <div class="video-embed reveal" data-video-id="CO_EE1X9Oh4" role="button" tabindex="0">
      <img src="https://img.youtube.com/vi/CO_EE1X9Oh4/hqdefault.jpg" alt="" loading="lazy">
      <button type="button" class="video-embed-play" aria-hidden="true" tabindex="-1">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
      </button>
    </div>
  </div>
</section>

<section class="bg-mist section-sm">
  <div class="container">
    <div class="head-row reveal">
      <h2>شركاؤنا</h2>
    </div>
    <div class="logo-grid reveal">
      <div class="logo-tile"><img src="~/assets/partners/partners/royal-commission-makkah.svg" alt="الهيئة الملكية لمدينة مكة المكرمة والمشاعر المقدسة" loading="lazy"></div>
      <div class="logo-tile"><img src="~/assets/partners/partners/isdb.svg" alt="البنك الإسلامي للتنمية" loading="lazy"></div>
      <div class="logo-tile"><img src="~/assets/partners/partners/ministry-sports.svg" alt="وزارة الرياضة" loading="lazy"></div>
      <div class="logo-tile"><img src="~/assets/partners/partners/ministry-hrsd.svg" alt="وزارة الموارد البشرية والتنمية الاجتماعية" loading="lazy"></div>
      <div class="logo-tile"><img src="~/assets/partners/partners/saudi-fund-development.svg" alt="الصندوق السعودي للتنمية" loading="lazy"></div>
      <div class="logo-tile"><img src="~/assets/partners/partners/national-development-fund.svg" alt="صندوق التنمية الوطني" loading="lazy"></div>
      <div class="logo-tile"><img src="~/assets/partners/partners/hrdf.svg" alt="صندوق تنمية الموارد البشرية" loading="lazy"></div>
      <div class="logo-tile"><img src="~/assets/partners/partners/jeddah-municipality.svg" alt="أمانة جدة" loading="lazy"></div>
      <div class="logo-tile"><img src="~/assets/partners/partners/historic-jeddah.svg" alt="جدة التاريخية" loading="lazy"></div>
      <div class="logo-tile"><img src="~/assets/partners/partners/real-estate-authority.svg" alt="الهيئة العامة للعقار" loading="lazy"></div>
      <div class="logo-tile"><img src="~/assets/partners/partners/charitable-associations-council.svg" alt="مجلس الجمعيات الأهلية" loading="lazy"></div>
      <div class="logo-tile"><img src="~/assets/partners/partners/makkah-newspaper.svg" alt="صحيفة مكة" loading="lazy"></div>
    </div>
  </div>
</section>

<section class="bg-ink why-section">
  <div class="container">
    <div class="why-head reveal">
      <div class="eyebrow">لماذا همم الحياة؟</div>
      <h2>لأننا نحوّل الأهداف إلى تجارب تُصنع بعناية وتُقاس نتائجها</h2>
      <p>لا نقدّم حلولاً جاهزة، بل نبدأ من فهم حقيقي لأهداف الجهة واحتياجات جمهورها، لنبني تجربة مترابطة من الفكرة إلى الأثر.</p>
    </div>

    <div class="why-grid">
      <div class="why-card reveal">
        <span class="why-num">01</span>
        <div class="why-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        </div>
        <h3>فهم قبل التنفيذ</h3>
        <p>نبدأ بفهم عميق لأهداف الجهة واحتياجات جمهورها قبل أي خطوة تنفيذية.</p>
      </div>

      <div class="why-card reveal">
        <span class="why-num">02</span>
        <div class="why-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg>
        </div>
        <h3>تنفيذ مدروس وقابل للقياس</h3>
        <p>نحوّل الأفكار إلى خطط عملية ومخرجات واضحة يمكن قياس نتائجها.</p>
      </div>

      <div class="why-card reveal">
        <span class="why-num">03</span>
        <div class="why-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h3>جهود موحّدة وأثر مستدام</h3>
        <p>نوحّد جهود الفرق والشركاء ضمن نطاق واضح يضمن جودة التنفيذ واستدامة الأثر.</p>
      </div>
    </div>
  </div>
</section>

<section class="section-sm">
  <div class="container">
    <div class="cta-band reveal">
      <div>
        <h2>هل تريد التعرف على فريق العمل؟</h2>
        <p>تواصل معنا لنناقش تفاصيل مشروعك ونبني معًا خطة تنفيذ واضحة.</p>
      </div>
      <a href="@Url.Action("Contact","Home",new{area="User"})" class="btn btn-ghost-light">تواصل معنا
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </a>
    </div>
  </div>
</section>

@section Scripts {
    <script src="https://www.youtube.com/iframe_api"></script>
    <script src="~/js/user/index.js"></script>
}
