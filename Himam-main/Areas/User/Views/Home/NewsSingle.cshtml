@{
    ViewData["Title"] = "إطلاق موسم الفعاليات الترفيهية بجدة | همم الحياة";
    ViewData["Description"] = "همم الحياة تدشّن موسماً جديداً من التجارب الترفيهية في جدة.";
    ViewData["Active"] = "news";
    // TODO: عند ربط قاعدة البيانات، استبدل المحتوى الثابت بالخبر المطابق لـ Model.Id
}
@section Styles {
    <link rel="stylesheet" href="~/css/user/news-single.css">
}

<section class="page-hero" style="padding-bottom:60px;">
  <div class="container">
    <div class="crumb"><a href="@Url.Action("Index","Home",new{area="User"})">الرئيسية</a><span>/</span><a href="@Url.Action("News","Home",new{area="User"})">أخبار وفعاليات</a><span>/</span><span>الخبر</span></div>
    <div class="eyebrow">فعالية</div>
    <h1 style="font-size:clamp(28px,4vw,44px); max-width:820px;">إطلاق موسم الفعاليات الترفيهية بجدة</h1>
  </div>
</section>

<section style="padding-top:20px;">
  <div class="container">
    <div class="article-wrap reveal">
      <a href="@Url.Action("News","Home",new{area="User"})" class="article-back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        الرجوع لكل الأخبار والفعاليات
      </a>

      <div class="article-banner"></div>

      <div class="article-meta">
        <span class="meta-date">12 يوليو 2026</span>
      </div>
      <h2 class="article-title">همم الحياة تدشّن موسماً جديداً من التجارب الترفيهية في جدة</h2>

      <div class="article-content">
        <h2>بداية موسم مليء بالتجارب</h2>
        <p>أعلنت همم الحياة عن انطلاق موسمها الجديد من الفعاليات الترفيهية في مدينة جدة، ضمن سلسلة من التجارب المصمَّمة خصيصاً لتلامس اهتمامات الجمهور وتُثري مشاركته، بما يعكس التزام الشركة بتقديم تجارب ذات أثر ملموس ومستدام.</p>

        <h2>تجارب مترابطة تضع الإنسان في جوهرها</h2>
        <p>يأتي هذا الإطلاق استكمالاً لمنهجية همم الحياة التي تجمع بين التفكير الاستراتيجي والإبداع والتنفيذ المنضبط، لتقديم تجارب مترابطة تنتقل بالفكرة من التصوّر إلى واقع يُعاش ويُتذكّر، وتمتد قيمتها إلى ما بعد انتهاء التنفيذ من خلال النتائج والأثر القابل للقياس.</p>

        <div class="article-media">
          <iframe src="https://www.youtube.com/embed/dQw4w9WgXcQ" title="فيديو الفعالية" allowfullscreen></iframe>
        </div>

        <h2>شراكات تدعم استمرارية الأثر</h2>
        <p>يشارك في هذا الموسم عدد من الجهات الحكومية والخاصة وغير الربحية، في إطار حرص همم الحياة على بناء شراكات تحقّق قيمة مشتركة ومستدامة لجميع الأطراف المعنية.</p>
      </div>

      <div class="article-tags">
        <span class="tag">فعاليات</span>
        <span class="tag">قطاع الترفيه والثقافة</span>
        <span class="tag">جدة</span>
      </div>
    </div>
  </div>
</section>

<section class="section-sm">
  <div class="container">
    <div class="cta-band reveal">
      <div>
        <h2>لديك هدف تريد تحويله إلى تجربة؟</h2>
        <p>لنتحدث عن مشروعك القادم، ونبني معًا مفهومًا قابلًا للتنفيذ والقياس.</p>
      </div>
      <a href="@Url.Action("Contact","Home",new{area="User"})" class="btn btn-ghost-light">تواصل معنا
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </a>
    </div>
  </div>
</section>

@section Scripts {
    <script src="~/js/user/news-single.js"></script>
}
