}

<section class="page-hero">
  <div class="container">
    <div class="crumb"><a href="@Url.Action("Index","Home",new{area="User"})">الرئيسية</a><span>/</span><span>أخبار وفعاليات</span></div>
    <div class="eyebrow">أخبار وفعاليات</div>
    <h1>آخر مستجداتنا<br>وفعالياتنا القادمة</h1>
    <p class="lede">تابع أحدث الأخبار والبرامج والفعاليات التي ننفذها مع شركائنا من مختلف القطاعات.</p>
  </div>
</section>

