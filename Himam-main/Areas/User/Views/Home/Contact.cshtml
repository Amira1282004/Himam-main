@model Himam_main.Models.ViewModels.ContactViewModel
@{
    ViewData["Title"] = "تواصل معنا | همم الحياة";
    ViewData["Description"] = "تواصل مع فريق همم الحياة لمناقشة فعاليتك أو برنامجك القادم.";
    ViewData["Active"] = "contact";
}
@section Styles {
    <link rel="stylesheet" href="~/css/user/contact.css">
}

<section class="page-hero" style="padding-bottom:50px;">
  <div class="container">
    <div class="crumb"><a href="@Url.Action("Index","Home",new{area="User"})">الرئيسية</a><span>/</span><span>تواصل معنا</span></div>
    <div class="eyebrow">تواصل معنا</div>
    <h1>لنحوّل هدفك القادم<br>إلى تجربة</h1>
    <p class="lede">شاركنا تفاصيل مشروعك، وسيتواصل معك فريقنا خلال يومي عمل لمناقشة الخطوات القادمة.</p>
  </div>
</section>

<section style="padding-top:20px;">
  <div class="container">
    <div class="contact-wrap">

      <div class="reveal">
        <div class="contact-info-card">
          <h3>بيانات التواصل</h3>
          @foreach (var info in Model.ContactInfo)
          {
              @if (!string.IsNullOrEmpty(info.Email))
              {
                  <div class="info-line">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h16v16H4z" opacity="0"/><path d="M3 6l9 6 9-6"/><rect x="3" y="5" width="18" height="14" rx="2"/></svg>
                    <span><strong>البريد الإلكتروني</strong>@info.Email</span>
                  </div>
              }
              @if (!string.IsNullOrEmpty(info.Phone))
              {
                  <div class="info-line">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.5 2.1L8 9.7a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.7 2z"/></svg>
                    <span><strong>الهاتف</strong>@info.Phone</span>
                  </div>
              }
              @if (!string.IsNullOrEmpty(info.Address))
              {
                  <div class="info-line">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    <span><strong>الموقع</strong>@info.Address</span>
                  </div>
              }
              @if (!string.IsNullOrEmpty(info.WorkingHours))
              {
                  <div class="info-line">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                    <span><strong>أوقات العمل</strong>@info.WorkingHours</span>
                  </div>
              }
          }
          <hr class="rule" style="border-color:rgba(255,255,255,.14); margin:22px 0;">
          <div class="social">
            @foreach (var social in Model.SocialMediaLinks)
            {
                <a href="@social.Url" aria-label="@social.PlatformName" target="_blank">
                  @if (!string.IsNullOrEmpty(social.IconSvg))
                  {
                      @Html.Raw(social.IconSvg)
                  }
                  else
                  {
                      <svg viewBox="0 0 24 24" fill="currentColor" style="color:#fff"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.209 2.8 4.908 5.293 6.767 4.539 1.443.257 3.497.298 4.736 1.858.266 2.368 1.317 4.48 1.48 1.48 0 011.48 1.48 1.48 1.48 0 01-2.32-.37 4.48 4.48 0 00-1.48 1.48 1.48 1.48 0 01-1.48-1.48 1.48 1.48 0 011.48-1.48 1.48 1.48 0 01-2.32-.37 4.48 4.48 0 00-1.48 1.48 1.48 1.48 0 01-1.48-1.48 1.48 1.48 0 011.48-1.48 1.48 1.48 0 01-2.32-.37 4.48 4.48 0 00-1.48 1.48"/></svg>
                  }
                </a>
            }
          </div>
        </div>
      </div>

      <div class="reveal">
        <form onsubmit="event.preventDefault(); document.getElementById('formNote').style.display='block'; this.reset();">
          <div class="field-row">
            <div class="field">
              <label for="name">الاسم الكامل</label>
              <input type="text" id="name" placeholder="اكتب اسمك" required>
            </div>
            <div class="field">
              <label for="org">الجهة / المؤسسة</label>
              <input type="text" id="org" placeholder="اسم الجهة">
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="email">البريد الإلكتروني</label>
              <input type="email" id="email" placeholder="example@@domain.com" required>
            </div>
            <div class="field">
              <label for="phone">رقم الجوال</label>
              <input type="tel" id="phone" placeholder="05xxxxxxxx">
            </div>
          </div>
          <div class="field">
            <label>القطاع</label>
            <div class="sector-pills">
              <label class="pill-check"><input type="radio" name="sector">حكومي</label>
              <label class="pill-check"><input type="radio" name="sector">خاص</label>
              <label class="pill-check"><input type="radio" name="sector">غير ربحي</label>
              <label class="pill-check"><input type="radio" name="sector">ترفيهي وثقافي</label>
              <label class="pill-check"><input type="radio" name="sector">سايحي وضيافة</label>
              <label class="pill-check"><input type="radio" name="sector">رياضي</label>
              <label class="pill-check"><input type="radio" name="sector">تعليمي</label>
              <label class="pill-check"><input type="radio" name="sector">رعاة وشركاء</label>
              <label class="pill-check"><input type="radio" name="sector">استثمار</label>
            </div>

          </div>
          <div class="field">
            <label for="message">تفاصيل المشروع</label>
            <textarea id="message" placeholder="أخبرنا عن هدفك، والجمهور المستهدف، والموعد المتوقع..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary" style="align-self:flex-start;">إرسال الطلب
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          </button>
          <p id="formNote" style="display:none; color:var(--turquoise-600); font-weight:600; font-size:14.5px;">تم استلام رسالتك، سيتواصل معك فريقنا قريبًا.</p>
        </form>
      </div>

    </div>

    @if (Model.ContactInfo.Any(c => !string.IsNullOrEmpty(c.MapEmbedUrl)))
    {
        <div class="map-block reveal">
          <iframe
            src="@Model.ContactInfo.FirstOrDefault(c => !string.IsNullOrEmpty(c.MapEmbedUrl))?.MapEmbedUrl"
            width="100%" height="100%" style="border:0;" allowfullscreen=""
            loading="lazy" referrerpolicy="no-referrer-when-downgrade"
            title="موقع همم الحياة على الخريطة">
          </iframe>
        </div>
    }
  </div>
</section>