@{
    ViewData["Title"] = "تواصل معنا | همم الحياة";
    ViewData["Description"] = "تواصل مع فريق همم الحياة لمناقشة فعاليتك أو برنامجك القادم.";
    ViewData["Active"] = "contact";
}
@section Styles {
    <link rel="stylesheet" href="~/css/user/contact.css">
}

<section class="page-hero" style="padding-bottom:50px;">
  <div class="container">
    <div class="crumb"><a href="@Url.Action("Index","Home",new{area="User"})">الرئيسية</a><span>/</span><span>تواصل معنا</span></div>
    <div class="eyebrow">تواصل معنا</div>
    <h1>لنحوّل هدفك القادم<br>إلى تجربة</h1>
    <p class="lede">شاركنا تفاصيل مشروعك، وسيتواصل معك فريقنا خلال يومي عمل لمناقشة الخطوات القادمة.</p>
  </div>
</section>

<section style="padding-top:20px;">
  <div class="container">
    <div class="contact-wrap">

      <div class="reveal">
        <div class="contact-info-card">
          <h3>بيانات التواصل</h3>
          <div class="info-line">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h16v16H4z" opacity="0"/><path d="M3 6l9 6 9-6"/><rect x="3" y="5" width="18" height="14" rx="2"/></svg>
            <span><strong>البريد الإلكتروني</strong>info@@himamalhayah.sa</span>
          </div>
          <div class="info-line">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.5 2.1L8 9.7a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.7 2z"/></svg>
            <span><strong>الهاتف</strong>0535105327</span>
          </div>
          <div class="info-line">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span><strong>الموقع</strong>جدة، حي مشرفة شارع عين الوهيط مبني 3654 الرمز البريدي23332</span>
          </div>
          <div class="info-line">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            <span><strong>أوقات العمل</strong>الأحد – الخميس، 9 صباحًا – 5 مساءً</span>
          </div>
          <hr class="rule" style="border-color:rgba(255,255,255,.14); margin:22px 0;">
          <div class="social">
            <a href="#" aria-label="إكس"><svg viewBox="0 0 24 24" fill="currentColor" style="color:#fff"><path d="M18.9 3H21l-6.6 7.5L22 21h-6.3l-4.9-6.4L5.2 21H3l7.1-8.1L2.5 3h6.4l4.4 5.8L18.9 3zm-1.1 16h1.2L7.3 5H6l11.8 14z"/></svg></a>
            <a href="#" aria-label="انستقرام"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" style="color:#fff"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg></a>
            <a href="#" aria-label="لينكدإن"><svg viewBox="0 0 24 24" fill="currentColor" style="color:#fff"><path d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1-.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.6c0-1.34-.02-3.06-1.87-3.06-1.87 0-2.16 1.46-2.16 2.96V21H9z"/></svg></a>
            <a href="#" aria-label="فيسبوك"><svg viewBox="0 0 24 24" fill="currentColor" style="color:#fff"><path d="M13.5 9H15V6h-1.6C11.4 6 10 7.5 10 9.8V11H8v3h2v7h3v-7h2.1l.4-3H13v-1c0-.6.2-1 .5-1z"/></svg></a>
            <a href="#" aria-label="سناب شات"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color:#fff"><path d="M12 3.2c-2.9 0-4.9 2.1-4.9 5v1.9c0 .8 0 1.5-.2 1.9-.3.7-1.4.9-2 1.2-.4.2-.3.6 0 .8.5.3 1.1.4 1.5.5.3.1.1.5-.1.8-.3.4-.8.8-.3 1.2.6.4 1.7.2 2.4.6.6.3.8 1.2 1.9 1.4.5.1 1-.1 1.6-.1.5 0 1 .2 1.6.1 1.1-.2 1.3-1.1 1.9-1.4.7-.4 1.8-.2 2.4-.6.5-.4 0-.8-.3-1.2-.2-.3-.4-.7-.1-.8.4-.1 1-.2 1.5-.5.3-.2.4-.6 0-.8-.6-.3-1.7-.5-2-1.2-.2-.4-.2-1.1-.2-1.9V8.2c0-2.9-2-5-4.9-5z"/></svg></a>
            <a href="#" aria-label="تيك توك"><svg viewBox="0 0 24 24" fill="currentColor" style="color:#fff"><path d="M16.5 2h-3v13.6a2.5 2.5 0 1 1-2.2-2.5v-3.2a5.6 5.6 0 1 0 5.2 5.6V9.1c1.2.8 2.6 1.3 4 1.3V7.3c-2 0-3.7-1.3-4.3-3.1-.2-.6-.2-1.4-.2-2.2z"/></svg></a>
            <a href="#" aria-label="يوتيوب"><svg viewBox="0 0 24 24" fill="currentColor" style="color:#fff"><path d="M22 8.4s-.2-1.5-.8-2.2c-.8-.9-1.7-.9-2.1-1C16.3 5 12 5 12 5s-4.3 0-7.1.2c-.4.1-1.3.1-2.1 1-.6.7-.8 2.2-.8 2.2S1.8 10.2 1.8 12v1.6c0 1.8.2 3.6.2 3.6s.2 1.5.8 2.2c.8.9 1.9.9 2.3 1 1.7.2 7 .2 7 .2s4.3 0 7.1-.2c.4-.1 1.3-.1 2.1-1 .6-.7.8-2.2.8-2.2s.2-1.8.2-3.6V12c0-1.8-.2-3.6-.2-3.6zM9.8 15.2V8.9l6 3.2-6 3.1z"/></svg></a>
            <a href="#" aria-label="واتساب"><svg viewBox="0 0 24 24" fill="currentColor" style="color:#fff"><path d="M12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.6 1.4 5.1L2 22l5-1.3c1.4.8 3.1 1.3 5 1.3 5.5 0 10-4.5 10-10S17.5 2 12 2zm5.6 14.2c-.2.6-1.3 1.2-1.8 1.3-.5.1-1 .1-1.7-.1-.4-.1-.9-.3-1.6-.6-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.4.2.5.7 1.8.8 1.9.1.1.1.3 0 .5-.1.2-.1.3-.3.5-.1.2-.3.4-.4.5-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.5 1.5.3.1.5.1.7-.1.2-.2.7-.8.9-1.1.2-.3.4-.2.6-.1.2.1 1.5.7 1.8.8.3.1.4.2.5.3.1.2.1.9-.1 1.5z"/></svg></a>
          </div>
        </div>
      </div>

      <div class="reveal">
        <form onsubmit="event.preventDefault(); document.getElementById('formNote').style.display='block'; this.reset();">
          <div class="field-row">
            <div class="field">
              <label for="name">الاسم الكامل</label>
              <input type="text" id="name" placeholder="اكتب اسمك" required>
            </div>
            <div class="field">
              <label for="org">الجهة / المؤسسة</label>
              <input type="text" id="org" placeholder="اسم الجهة">
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="email">البريد الإلكتروني</label>
              <input type="email" id="email" placeholder="example@@domain.com" required>
            </div>
            <div class="field">
              <label for="phone">رقم الجوال</label>
              <input type="tel" id="phone" placeholder="05xxxxxxxx">
            </div>
          </div>
          <div class="field">
            <label>القطاع</label>
            <div class="sector-pills">
              <label class="pill-check"><input type="radio" name="sector">حكومي</label>
              <label class="pill-check"><input type="radio" name="sector">خاص</label>
              <label class="pill-check"><input type="radio" name="sector">غير ربحي</label>
              <label class="pill-check"><input type="radio" name="sector">ترفيهي وثقافي</label>
              <label class="pill-check"><input type="radio" name="sector">سايحي وضيافة</label>
              <label class="pill-check"><input type="radio" name="sector">رياضي</label>
              <label class="pill-check"><input type="radio" name="sector">تعليمي</label>
              <label class="pill-check"><input type="radio" name="sector">رعاة وشركاء</label>
              <label class="pill-check"><input type="radio" name="sector">استثمار</label>
            </div>

          </div>
          <div class="field">
            <label for="message">تفاصيل المشروع</label>
            <textarea id="message" placeholder="أخبرنا عن هدفك، والجمهور المستهدف، والموعد المتوقع..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary" style="align-self:flex-start;">إرسال الطلب
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          </button>
          <p id="formNote" style="display:none; color:var(--turquoise-600); font-weight:600; font-size:14.5px;">تم استلام رسالتك، سيتواصل معك فريقنا قريبًا.</p>
        </form>
      </div>

    </div>

    <div class="map-block reveal">
      <iframe
        src="https://www.google.com/maps?q=%D8%AC%D8%AF%D8%A9%D8%8C%20%D8%AD%D9%8A%20%D9%85%D8%B4%D8%B1%D9%81%D8%A9%D8%8C%20%D8%B4%D8%A7%D8%B1%D8%B9%20%D8%B9%D9%8A%D9%86%20%D8%A7%D9%84%D9%88%D9%87%D9%8A%D8%B7&output=embed"
        width="100%" height="100%" style="border:0;" allowfullscreen=""
        loading="lazy" referrerpolicy="no-referrer-when-downgrade"
        title="موقع همم الحياة على الخريطة">
      </iframe>
    </div>

  </div>
</section>

@section Scripts {
    <script src="~/js/user/contact.js"></script>
}
