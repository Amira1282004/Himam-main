@{
    ViewData["Title"] = "من نحن | همم الحياة";
    ViewData["Description"] = "همم الحياة شركة سعودية تجمع بين التفكير الاستراتيجي والتصميم الإبداعي وإدارة المشروعات لصناعة تجارب متكاملة.";
    ViewData["Active"] = "about";
}
@section Styles {
    <link rel="stylesheet" href="~/css/user/about.css">
}

<section class="page-hero">
  <div class="container">
    <div class="crumb"><a href="@Url.Action("Index","Home",new{area="User"})">الرئيسية</a><span>/</span><span>من نحن</span></div>

    <div class="page-hero-grid">
      <div class="page-hero-content reveal">
        <div class="eyebrow">من نحن</div>
        <h1>نُوحّد التفكير الاستراتيجي<br>والتنفيذ الدقيق في رؤية واحدة</h1>
        <p class="lede">
          همم الحياة الشركة المتخصصة التابعة لمجموعة الشهراني للأعمال في تصميم وتطوير وتنفيذ التجارب الترفيهية والفعاليات
          والمشروعات المتكاملة. نعمل مع الجهات الحكومية والخاصة وغير الربحية، ونحوّل أهدافها إلى مفاهيم وتجارب قابلة للتنفيذ
          والقياس. وتجمع منهجيتنا بين الاستراتيجية والمحتوى والتصميم والإدارة الفنية والتشغيلية؛ لضمان تكامل عناصر المشروع،
          ورفع جودة التنفيذ، وتعزيز جاهزيته، وتحقيق قيمة واضحة للجهة وتجربة أكثر اتساقًا وسهولة في الوصول والمشاركة للجمهور.
        </p>
      </div>

      <div class="page-hero-brands reveal">
        <div class="brand-panel">
          <div class="brand-lockup">
            <div class="brand-tile">
              <img src="~/assets/logo-stacked.png" alt="همم الحياة">
            </div>
            <div class="brand-lockup-divider"></div>
            <div class="brand-tile">
              <img src="~/assets/alshahrani-logo.png" alt="مجموعة الشهراني للأعمال">
            </div>
          </div>
          <span class="brand-lockup-text">همم الحياة أحد مشاريع مجموعة الشهراني للأعمال</span>
        </div>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="container">
    <div class="head-row reveal">
      <h2>قيمنا</h2>
    </div>
    <div class="grid grid-2">
      <div class="card reveal">
        <h3>قصتنا</h3>
        <p>تنطلق همم الحياة من همّة تسعى إلى تحويل الأفكار والرسائل والأهداف إلى تجارب حقيقية ذات أثر ملموس. نجمع بين
          التفكير الاستراتيجي والتنفيذ المنضبط؛ لنقدّم تجارب مترابطة تضع الإنسان في جوهرها، وتنتقل بالفكرة من التصوّر
          إلى واقع يُعاش ويُتذكّر. ولا تنتهي قيمة التجربة بانتهاء تنفيذها، بل تمتد إلى ما تحققه من نتائج، وما تتركه من
          أثر يمكن قياسه وتطويره والبناء عليه.</p>
      </div>
      <div class="card reveal">
        <h3>رؤيتنا</h3>
        <p>أن نرسّخ مكانتنا كشركة سعودية رائدة، محليًا وإقليميًا، في صناعة التجارب والفعاليات والبرامج والمشروعات
          المتكاملة، من خلال حلول نوعية تُثري مشاركة الجمهور، وتسهم في تعزيز جودة الحياة، وتقدّم قيمة ممتدة للشركاء
          والمجتمع.</p>
      </div>
      <div class="card reveal">
        <h3>رسالتنا</h3>
        <p>نحوّل أهداف شركائنا وأفكارهم إلى تجارب وبرامج ومشروعات متكاملة ذات قيمة واضحة، تجمع بين التفكير الاستراتيجي
          والتصميم الإبداعي والتنفيذ المنضبط والقياس، بما يدعم تحقيق مستهدفات الجهات ويمنح الجمهور تجارب ذات معنى
          وأثر.</p>
      </div>
      <div class="card reveal">
        <h3>مهمتنا</h3>
        <p>نصمّم ونطوّر وننفّذ تجارب وفعاليات وبرامج ومشروعات تنطلق من فهم الإنسان واحتياجاته، وتتكامل فيها الاستراتيجية
          مع المحتوى النوعي والتصميم الإبداعي والإدارة التنفيذية المنضبطة. ونحرص على أن تعزز أعمالنا مشاركة الجمهور،
          وتحقق قيمة مؤسسية ملموسة لشركائنا، وتنتج نتائج قابلة للقياس والتطوير والبناء عليها.</p>
      </div>
    </div>
  </div>
</section>

<section class="bg-mist">
  <div class="container">
    <div class="head-row reveal">
      <h2>من فهم الجمهور إلى تقييم النتائج</h2>
      <p>نوحّد جميع عناصر المشروع ضمن رؤية متكاملة لصناعة تجارب أكثر اتساقًا وقيمة وقابلية للتطوير.</p>
    </div>
    <div class="process reveal">
      <div class="process-path"></div>
      <div class="process-list">
        <div class="process-step"><div class="badge">01</div><h4>فهم الجمهور</h4><p>بحث ورؤية دقيقة</p></div>
        <div class="process-step"><div class="badge">02</div><h4>التخطيط الاستراتيجي</h4><p>مفهوم قابل للقياس</p></div>
        <div class="process-step"><div class="badge">03</div><h4>التصميم الإبداعي</h4><p>هوية وتجربة متكاملة</p></div>
        <div class="process-step"><div class="badge">04</div><h4>تطوير المحتوى</h4><p>رسائل تخدم الهدف</p></div>
        <div class="process-step"><div class="badge">05</div><h4>التنفيذ التشغيلي</h4><p>إدارة دقيقة للمشروع</p></div>
        <div class="process-step"><div class="badge">06</div><h4>تقييم النتائج</h4><p>قياس الأثر والتطوير</p></div>
      </div>
    </div>
  </div>
</section>

<section class="section-sm">
  <div class="container">
    <div class="cta-band reveal">
      <div>
        <h2>هل تريد التعرف على فريق العمل؟</h2>
        <p>تواصل معنا لنناقش تفاصيل مشروعك ونبني معًا خطة تنفيذ واضحة.</p>
      </div>
      <a href="@Url.Action("Contact","Home",new{area="User"})" class="btn btn-ghost-light">تواصل معنا
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </a>
    </div>
  </div>
</section>

@section Scripts {
    <script src="~/js/user/about.js"></script>
}
