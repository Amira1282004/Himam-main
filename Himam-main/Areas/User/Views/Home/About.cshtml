@model Himam_main.Models.ViewModels.AboutViewModel
@{
    ViewData["Title"] = "من نحن | همم الحياة";
    ViewData["Description"] = "همم الحياة شركة سعودية تجمع بين التفكير الاستراتيجي والتصميم الإبداعي وإدارة المشروعات لصناعة تجارب متكاملة.";
    ViewData["Active"] = "about";
}
@section Styles {
    <link rel="stylesheet" href="~/css/user/about.css">
}

<section class="page-hero">
  <div class="container">
    <div class="crumb"><a href="@Url.Action("Index","Home",new{area="User"})">الرئيسية</a><span>/</span><span>من نحن</span></div>

    <div class="page-hero-grid">
      <div class="page-hero-content reveal">
        <div class="eyebrow">من نحن</div>
        <h1>نُوحّد التفكير الاستراتيجي<br>والتنفيذ الدقيق في رؤية واحدة</h1>
        <p class="lede">
          همم الحياة الشركة المتخصصة التابعة لمجموعة الشهراني للأعمال في تصميم وتطوير وتنفيذ التجارب الترفيهية والفعاليات
          والمشروعات المتكاملة. نعمل مع الجهات الحكومية والخاصة وغير الربحية، ونحوّل أهدافها إلى مفاهيم وتجارب قابلة للتنفيذ
          والقياس. وتجمع منهجيتنا بين الاستراتيجية والمحتوى والتصميم والإدارة الفنية والتشغيلية؛ لضمان تكامل عناصر المشروع،
          ورفع جودة التنفيذ، وتعزيز جاهزيته، وتحقيق قيمة واضحة للجهة وتجربة أكثر اتساقًا وسهولة في الوصول والمشاركة للجمهور.
        </p>
      </div>

      <div class="page-hero-brands reveal">
        <div class="brand-panel">
          <div class="brand-lockup">
            <div class="brand-tile">
              <img src="~/assets/logo-stacked.png" alt="همم الحياة">
            </div>
            <div class="brand-lockup-divider"></div>
            <div class="brand-tile">
              <img src="~/assets/alshahrani-logo.png" alt="مجموعة الشهراني للأعمال">
            </div>
          </div>
          <span class="brand-lockup-text">همم الحياة أحد مشاريع مجموعة الشهراني للأعمال</span>
        </div>
      </div>
    </div>
  </div>
</section>

@if (Model.CompanyValues.Any())
{
    <section>
      <div class="container">
        <div class="head-row reveal">
          <h2>قيمنا</h2>
        </div>
        <div class="grid grid-2">
          @foreach (var value in Model.CompanyValues)
          {
              <div class="card reveal">
                <h3>@value.Title</h3>
                <p>@value.Content</p>
              </div>
          }
        </div>
      </div>
    </section>
}

@if (Model.ProcessSteps.Any())
{
    <section class="bg-mist">
      <div class="container">
        <div class="head-row reveal">
          <h2>من فهم الجمهور إلى تقييم النتائج</h2>
          <p>نوحّد جميع عناصر المشروع ضمن رؤية متكاملة لصناعة تجارب أكثر اتساقًا وقيمة وقابلية للتطوير.</p>
        </div>
        <div class="process reveal">
          <div class="process-path"></div>
          <div class="process-list">
            @foreach (var step in Model.ProcessSteps)
            {
                <div class="process-step">
                  <div class="badge">@step.StepNumber.ToString("D2")</div>
                  <h4>@step.Title</h4>
                  <p>@step.Subtitle</p>
                </div>
            }
          </div>
        </div>
      </div>
    </section>
}

<section class="section-sm">
  <div class="container">
    <div class="cta-band reveal">
      <div>
        <h2>هل تريد التعرف على فريق العمل؟</h2>
        <p>تواصل معنا لنناقش تفاصيل مشروعك ونبني معًا خطة تنفيذ واضحة.</p>
      </div>
      <a href="@Url.Action("Contact","Home",new{area="User"})" class="btn btn-ghost-light">تواصل معنا
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </a>
    </div>
  </div>
</section>

@section Scripts {
    <script src="~/js/user/about.js"></script>
}
